{
  "name": "workorder",
  "version": "0.1.0",
  "private": true,
  "description": "A desktop workspace for teams, materials and projects",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "node --env-file=.env backend/start.cjs",
    "test": "node --test tests/*.test.cjs tests/backend/*.test.cjs",
    "api": "node --env-file=.env backend/start.cjs",
    "db:migrate": "node --env-file=.env backend/start.cjs --migrate",
    "test:backend": "node --test tests/backend/*.test.cjs",
    "test:console": "playwright test --config=playwright.console.config.cjs",
    "web": "node --env-file=.env backend/start.cjs",
    "icons": "node scripts/generate-icons.mjs",
    "mobile:build": "node scripts/build-mobile.mjs",
    "mobile:sync": "npm run mobile:build && cap sync",
    "mobile:ios": "npm run mobile:sync && cap open ios",
    "mobile:android": "npm run mobile:sync && cap open android"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/ios": "^7.6.9",
    "@playwright/test": "^1.63.0",
    "electron": "^44.2.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@capacitor/app": "^7.1.2",
    "@capacitor/camera": "^7.0.5",
    "@capacitor/core": "^7.6.9",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/geolocation": "^7.1.8",
    "@capacitor/network": "^7.0.4",
    "@capacitor/preferences": "^7.0.4",
    "@capacitor/push-notifications": "^7.0.7",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "sequelize": "^6.37.8",
    "stripe": "^22.6.2",
    "zod": "^4.6.2"
  },
  "overrides": {
    "sequelize": {
      "uuid": "11.1.1"
    }
  }
}
